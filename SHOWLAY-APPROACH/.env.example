# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# AWS credentials for Bedrock access (us-west-2 — Qwen3-VL is hosted there)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-west-2

# Primary VLM for per-page extraction.
# `qwen.qwen3-vl-235b-a22b` is currently the best price/quality VLM on Bedrock for forms;
# it accepts text + image input and emits JSON. Native PDF input is NOT supported, so we
# rasterize each page to PNG before sending.
BEDROCK_VLM_MODEL_ID=qwen.qwen3-vl-235b-a22b

# Optional verifier (Claude Haiku 4.5) for low-confidence rows. Reserved for v2.
BEDROCK_VERIFIER_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Optional local path overrides. Relative paths are resolved from SHOWLAY-APPROACH.
# Leave these commented unless you need a custom template or runtime location.
# SHOWLAY_TEMPLATE_PATH=support_docs/CHOICES Safety Determination Request Form Final_11_20.xlsx
# SHOWLAY_SUPPORT_DOCS_DIR=support_docs
# SHOWLAY_RUNTIME_DIR=runtime

# Optional: only needed for compare_agentic.py.
# AGENTIC_BRANCH_DIR=external/agentic-pydantic-ai
